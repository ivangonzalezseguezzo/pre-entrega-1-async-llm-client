# Copiá este archivo a .env y completá tus claves. NUNCA subas el .env a GitHub.

# --- API keys (con una sola alcanza; las que dejes vacías se omiten) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Proveedor por defecto para AsyncLLMManager.from_env() (openai | anthropic | gemini) ---
LLM_PROVIDER=gemini

# --- Proveedores de respaldo si el principal falla, en orden y separados por coma (opcional) ---
LLM_FALLBACKS=openai,anthropic

# --- Modelos (opcional; si se omiten se usan los valores por defecto) ---
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_MODEL=gemini-3.6-flash

# --- Parámetros del modelo (opcional; validados con Pydantic) ---
# temperature: 0 a 2 (se aplica en OpenAI y Gemini; la API actual de Anthropic no acepta temperature)
LLM_TEMPERATURE=0.7
# Los modelos que "piensan" (Gemini 3) gastan parte de este límite razonando: no lo bajes de ~1024
LLM_MAX_TOKENS=2048
# Timeout por request (segundos) y cantidad de reintentos ante rate limit / errores de red
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3
